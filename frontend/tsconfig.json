{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx", "strict": true, "noUncheckedIndexedAccess": true, "noEmit": true, "skipLibCheck": true,
    "allowJs": false, "isolatedModules": true, "types": ["vite/client", "node"]
  },
  "include": ["src", "vite.config.ts", "vite.mount.config.ts", "vitest.config.ts"]
}
