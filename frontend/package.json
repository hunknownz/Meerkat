{
  "name": "meerkat-frontend",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "generate": "node scripts/generate-types.mjs",
    "types": "npm run generate",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "npm run generate && npm run check && vite build && vite build --config vite.mount.config.ts && node scripts/copy-assets.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "25.0.1",
    "json-schema-to-typescript": "15.0.3",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
