{
  "name": "meerkat-frontend",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "generate": "node scripts/generate-types.mjs",
    "types": "npm run generate",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "npm run generate && npm run check && vite build && vite build --config vite.mount.config.ts && node scripts/copy-assets.mjs"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.1.0",
    "@types/node": "22.10.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "jsdom": "25.0.1",
    "json-schema-to-typescript": "15.0.3",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
