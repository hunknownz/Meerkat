{
  "mcpServers": {
    "meerkat": {
      "command": "/bin/sh",
      "args": [
        "-c",
        "exec \"${CODEX_MCP_NODE_PATH:-node}\" ./scripts/launch.mjs mcp",
        "--"
      ],
      "cwd": ".",
      "env_vars": [
        "CODEX_MCP_NODE_PATH",
        "MEERKAT_BIN",
        "MEERKAT_RUNTIME_DIR",
        "MEERKAT_DATA_DIR"
      ]
    }
  }
}
