{
  "mcpServers": {
    "meerkat": {
      "command": "node",
      "args": [
        "./scripts/launch.mjs",
        "mcp"
      ],
      "cwd": ".",
      "env_vars": [
        "CODEX_MCP_NODE_PATH",
        "MEERKAT_BIN",
        "MEERKAT_RUNTIME_DIR",
        "MEERKAT_DATA_DIR"
      ]
    }
  }
}
